# Copy to .env.local and adjust. Paths are relative to this folder.

# The admin's database, hosted on Turso (same database local dev and
# production both read/write; see https://app.turso.tech). Media files
# (photos/videos) live there too, in the media_files table, served by
# this app's own /media route.
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=

# 1 = preview: show draft and in-review cities, unchecked story paragraphs and
# media whose permission is not yet granted, with a banner and labels.
# 0 = live: only published cities, checked paragraphs, granted/own media.
VG_PREVIEW=1

# Shop (not used yet; the shop pages say "opening soon" until these are set).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# Customer accounts (Shopify Customer Account API; separate from the Storefront token above).
# Needs "New customer accounts" turned on under Settings > Customer accounts, then the
# Customer Account API client's ID and the numeric shop id shown on that same settings page.
# SITE_URL must exactly match a redirect URI registered there, with /api/auth/callback appended.
SHOPIFY_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SITE_URL=http://localhost:3000
